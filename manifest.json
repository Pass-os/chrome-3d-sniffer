{
  "manifest_version": 3,
  "name": "3D Model Sniffer",
  "version": "0.1.0",
  "description": "Detecta e baixa modelos 3D (GLB, glTF, FBX, OBJ, STL, PLY, USDZ...) olhando os bytes das requisições da página.",
  "permissions": [
    "webRequest",
    "webNavigation",
    "downloads",
    "storage",
    "tabs",
    "nativeMessaging"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "3D Model Sniffer"
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "inject.js",
        "glb.js",
        "scene.js",
        "picker.js"
      ],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true
    }
  ],
  "key": "",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}